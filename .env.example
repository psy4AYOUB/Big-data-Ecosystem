# Copier ce fichier en .env puis changer les mots de passe :  cp .env.example .env
# Le fichier .env n'est jamais envoye sur GitHub (voir .gitignore).

# --- Versions -----------------------------------------------------------
ELASTIC_VERSION=9.5.6
KAFKA_VERSION=4.4.0
CASSANDRA_VERSION=5.0
# Image officielle "spark:<version>-scala2.12-java17-python3-ubuntu" (Spark 3.5.x :
# le connecteur Cassandra ne supporte pas encore Spark 4)
SPARK_VERSION=3.5.8
ES_SPARK_VERSION=9.3.0
CASSANDRA_CONNECTOR_VERSION=3.5.1

# --- Mots de passe (fictifs, a changer) -----------------------------------
ELASTIC_PASSWORD=changez-moi-elastic
KIBANA_SYSTEM_PASSWORD=changez-moi-kibana
SPARK_ES_PASSWORD=changez-moi-spark
# 32 caracteres minimum
KIBANA_ENCRYPTION_KEY=changez-moi-cle-de-32-caracteres-minimum
